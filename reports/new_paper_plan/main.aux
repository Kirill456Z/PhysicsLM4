\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Canon insertion points.} A depthwise causal convolution can be placed at four positions within a transformer block: pre-attention (A), post-attention (B), pre-FFN (C), and post-FFN (D). \textsc  {Canon}\xspace  denotes the full A/B/C/D configuration; the baseline \textsc  {Llama}\xspace  removes all four.}}{7}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:canon_scheme}{{1}{7}{\textbf {Canon insertion points.} A depthwise causal convolution can be placed at four positions within a transformer block: pre-attention (A), post-attention (B), pre-FFN (C), and post-FFN (D). \Canon denotes the full A/B/C/D configuration; the baseline \Llama removes all four}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Benchmark reliability varies by task.} Text modelling is stable across seeds; \textsc  {Depo}\xspace  and \textsc  {Brevo}\xspace  grok at a seed-dependent step, making single-run rankings unreliable. Seed-to-seed variance concentrates on \textsc  {Depo}\xspace  ; all graph-search tasks are stable.}}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:reliability}{{2}{8}{\textbf {Benchmark reliability varies by task.} Text modelling is stable across seeds; \Depo and \Brevo grok at a seed-dependent step, making single-run rankings unreliable. Seed-to-seed variance concentrates on \Depo ; all graph-search tasks are stable}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {\textsc  {Canon}\xspace  outperforms \textsc  {Llama}\xspace  at every scale when averaging over seeds.} The gap is largest for small models and narrows with scale. At 30M the gain is concentrated on \textsc  {Depo}\xspace  ; improvements on other tasks are minor or absent.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:scaling}{{3}{8}{\textbf {\Canon outperforms \Llama at every scale when averaging over seeds.} The gap is largest for small models and narrows with scale. At 30M the gain is concentrated on \Depo ; improvements on other tasks are minor or absent}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {\textsc  {Canon}\xspace  substitutes for model depth (param-matched, $\sim $85M).} \textsc  {Llama}\xspace  improves with depth, acquiring multi-hop retrieval (\textsc  {Depo}\xspace  ) only at 14 layers; \textsc  {Canon}\xspace  reaches comparable performance several layers shallower. \textsc  {Canon}\xspace  at 10 layers matches a 14-layer \textsc  {Llama}\xspace  on \textsc  {Depo}\xspace  , and \textsc  {Canon}\xspace  at 12 layers is the strongest model overall.}}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:depth}{{4}{9}{\textbf {\Canon substitutes for model depth (param-matched, $\sim $85M).} \Llama improves with depth, acquiring multi-hop retrieval (\Depo ) only at 14 layers; \Canon reaches comparable performance several layers shallower. \Canon at 10 layers matches a 14-layer \Llama on \Depo , and \Canon at 12 layers is the strongest model overall}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {\textsc  {Canon}\xspace  configuration ablations.} Positions A and C (pre-attention and pre-FFN) capture the full gain; B and D are droppable. All initialisation schemes outperform the \textsc  {Llama}\xspace  baseline, including zero initialisation; the benefit is structurally inherent to the convolution, not to the choice of starting weights.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:ablations}{{5}{9}{\textbf {\Canon configuration ablations.} Positions A and C (pre-attention and pre-FFN) capture the full gain; B and D are droppable. All initialisation schemes outperform the \Llama baseline, including zero initialisation; the benefit is structurally inherent to the convolution, not to the choice of starting weights}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Mechanism is reproducible where the score is not.} Deep/shallow gradient ratio over training, one line per seed. The \textsc  {Canon}\xspace  seeds (held low and tightly bundled) and the \textsc  {Llama}\xspace  seeds (drifting upward) form two non-overlapping bundles, even though the final \textsc  {Depo}\xspace  score varies seed to seed within each architecture.}}{10}{figure.caption.12}\protected@file@percent }
\newlabel{fig:mech_seeds}{{6}{10}{\textbf {Mechanism is reproducible where the score is not.} Deep/shallow gradient ratio over training, one line per seed. The \Canon seeds (held low and tightly bundled) and the \Llama seeds (drifting upward) form two non-overlapping bundles, even though the final \Depo score varies seed to seed within each architecture}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {\textsc  {Canon}\xspace  's across-layer reorganization signature.} \textsc  {Canon}\xspace  suppresses the deep-layer gradient dominance that \textsc  {Llama}\xspace  develops, amplifies deep-layer representations, and distributes the per-layer gradient profile more evenly, changes that resemble the effect of scaling the model up.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:dynamics}{{7}{10}{\textbf {\Canon 's across-layer reorganization signature.} \Canon suppresses the deep-layer gradient dominance that \Llama develops, amplifies deep-layer representations, and distributes the per-layer gradient profile more evenly, changes that resemble the effect of scaling the model up}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Cross-token mixing is the necessary ingredient.} $k{=}1$ (no mixing) performs worse than the baseline; loss improves monotonically with kernel size. The learned weights favour farther-back tokens from initialisation, with the strongest mixing in early layers.}}{11}{figure.caption.14}\protected@file@percent }
\newlabel{fig:flow}{{8}{11}{\textbf {Cross-token mixing is the necessary ingredient.} $k{=}1$ (no mixing) performs worse than the baseline; loss improves monotonically with kernel size. The learned weights favour farther-back tokens from initialisation, with the strongest mixing in early layers}{figure.caption.14}{}}
